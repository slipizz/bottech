# Telegram bot token from @BotFather
BOT_TOKEN=

# ID of support supergroup/forum where topics will be created
# Example: -1001234567890
SUPPORT_CHAT_ID=

# Optional admin IDs (comma-separated) for permission checks if needed later
ADMIN_IDS=

# AI provider settings (OpenAI-compatible)
AI_ENABLED=true
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# For OpenAI use default https://api.openai.com/v1
AI_BASE_URL=
